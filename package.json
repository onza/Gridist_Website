{
  "name": "gridist-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "npm run lint && npm run format:check && eleventy",
    "preview": "eleventy --serve --port=4173",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.scss\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "a11y": "node scripts/a11y.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-vite": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.12.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "handlebars": "^4.7.9",
    "js-yaml": "^5.1.0",
    "prettier": "^3.8.4",
    "puppeteer-core": "^25.4.0",
    "sass": "^1.101.3",
    "stylelint": "^17.13.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^17.0.0"
  }
}
